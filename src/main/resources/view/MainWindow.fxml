<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nori.ui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>
            <Label styleClass="title" text="Nori" />
            <Label styleClass="subtitle" text="  Your task companion" />
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    pannable="true" styleClass="chat-scroll">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" styleClass="input-bar">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                       onAction="#handleUserInput" promptText="Type a command..." />
            <Button fx:id="sendButton" defaultButton="true"
                    onAction="#handleUserInput" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
